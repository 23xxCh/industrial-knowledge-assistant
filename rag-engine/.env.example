# RAG 引擎环境变量配置
# 复制此文件为 .env 并填入实际值

# OpenAI 兼容接口（支持 DeepSeek/Qwen 等）
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型配置
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# 存储路径
CHROMA_PERSIST_DIR=./chroma_db
BM25_PERSIST_PATH=./bm25_index.json

# 分块参数
CHUNK_SIZE=600
CHUNK_OVERLAP=200

# 服务配置
HOST=0.0.0.0
PORT=8000
UPLOAD_DIR=./uploads
